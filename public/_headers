/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

/sitemap.xml
  Cache-Control: public, max-age=3600

/blog/*
  Cache-Control: public, max-age=86400

# Allow the Reservation Relief Nexus demos to frame the OSBW sandbox.
/inventory/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://reservationrelief.com https://*.reservationrelief.com

/inventory
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://reservationrelief.com https://*.reservationrelief.com
